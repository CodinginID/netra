# Environment for docker-compose.db.yml (the standalone database server).
# Copy to `.env` on the DB server and set strong, unique passwords.

# Superuser / owner (used by Alembic migrations from the backend server).
POSTGRES_USER=netra
POSTGRES_PASSWORD=CHANGE_ME_strong_db_owner_password
POSTGRES_DB=netra

# Host port the DB is published on (backend connects to <db-server-ip>:<this>).
DB_HOST_PORT=5436

# --- Reminder: the least-privilege app role (netra_app) is created by the
# --- Alembic migration, not here. After the DB is up, run from the BACKEND:
# ---   alembic upgrade head
# --- with:
# ---   DATABASE_ADMIN_URL=postgresql+asyncpg://netra:<POSTGRES_PASSWORD>@<db-ip>:5436/netra
# ---   DATABASE_URL=postgresql+asyncpg://netra_app:<netra_app_password>@<db-ip>:5436/netra
# --- (the netra_app password is set inside migration b69335609137 — change it
# ---  there or via `ALTER ROLE netra_app PASSWORD '...'` for production.)
