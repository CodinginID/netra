# netra backend — environment configuration (copy to .env and adjust)
APP_NAME=netra
ENVIRONMENT=development
DEBUG=true

# Database (async asyncpg DSN). Docker dev maps Postgres to host port 5436.
DATABASE_URL=postgresql+asyncpg://netra:netra@localhost:5436/netra
DB_ECHO=false

# Security — MUST override in production
SECRET_KEY=CHANGE_ME_dev_only_secret_key_min_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Field encryption (Fernet base64 key). Empty -> derived from SECRET_KEY in dev only.
ENCRYPTION_KEY=

# Face engine (Phase 3+)
EMBEDDING_DIM=512
MATCH_THRESHOLD=0.45
