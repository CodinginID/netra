# netra backend — environment configuration (copy to .env and adjust)
APP_NAME=netra
ENVIRONMENT=development
DEBUG=true
LOG_JSON=true          # true = JSON logs (default); false = pretty colored console

# Database — local dev (uvicorn on host, Postgres exposed on port 5436).
# For docker compose --profile full, the backend service overrides hostname to
# @postgres:5432 automatically; credentials below are still read from this file.
DATABASE_URL=postgresql+asyncpg://netra_app:netra_app@localhost:5436/netra
DATABASE_ADMIN_URL=postgresql+asyncpg://netra:netra@localhost:5436/netra
DB_ECHO=false

# Security — MUST override in production
SECRET_KEY=CHANGE_ME_dev_only_secret_key_min_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Field encryption (Fernet base64 key). Empty -> derived from SECRET_KEY in dev only.
ENCRYPTION_KEY=

# CORS — comma-separated list of allowed origins (override via env if needed)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Face engine: "fake" (no ML, deterministic) | "insightface" (real ArcFace ONNX)
FACE_ENGINE=fake
EMBEDDING_DIM=512
MATCH_THRESHOLD=0.45
