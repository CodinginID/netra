# netra — Docker Compose variable substitution
# Copy to .env at the project root to override credentials without editing docker-compose.yml.
# Docker Compose reads this file automatically for ${VAR} interpolation in docker-compose.yml.
#
# For backend app config (SECRET_KEY, FACE_ENGINE, etc.) see backend/.env.example.

# Postgres service credentials
POSTGRES_USER=netra
POSTGRES_PASSWORD=netra
POSTGRES_DB=netra

# Least-privilege application role (created by Alembic migration b69335609137)
APP_DB_USER=netra_app
APP_DB_PASSWORD=netra_app
